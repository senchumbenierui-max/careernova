# Copy to .env.local for `npm run dev`, and set the same variables in Vercel → Project → Settings → Environment Variables.
# Never commit .env.local. The key is only read by the server (api/), never by the browser.

# Free key from https://console.groq.com/keys
GROQ_API_KEY=

# Optional. Groq renames models from time to time.
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Optional. Extra sites allowed to call /api/chat, comma-separated. The site's own domain is always allowed.
# ALLOWED_ORIGINS=https://my-preview.vercel.app
